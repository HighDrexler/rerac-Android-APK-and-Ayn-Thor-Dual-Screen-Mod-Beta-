<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><groupId>org.rerac.android</groupId><artifactId>launcher-recovery-tests</artifactId><version>1.1</version>
  <properties><maven.compiler.release>8</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <repositories><repository><id>google</id><url>https://dl.google.com/dl/android/maven2/</url></repository></repositories>
  <dependencies>
    <dependency><groupId>org.robolectric</groupId><artifactId>android-all</artifactId><version>14-robolectric-10818077</version><scope>provided</scope></dependency>
    <dependency><groupId>org.robolectric</groupId><artifactId>robolectric</artifactId><version>4.14.1</version><scope>test</scope></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <dependency><groupId>org.json</groupId><artifactId>json</artifactId><version>20240303</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>android/src</sourceDirectory><testSourceDirectory>android/tests</testSourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <!-- Test harness only; AndroidX and the resource fixture never enter the shipped APK. -->
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId><version>3.1.0</version>
        <executions><execution><id>androidx-test-runtime</id><phase>process-test-classes</phase><goals><goal>run</goal></goals>
          <configuration><target>
            <unzip src="${settings.localRepository}/androidx/test/monitor/1.7.2/monitor-1.7.2.aar" dest="${project.build.directory}/test-aars/monitor"/>
            <unzip src="${settings.localRepository}/androidx/test/espresso/espresso-idling-resource/3.6.1/espresso-idling-resource-3.6.1.aar" dest="${project.build.directory}/test-aars/espresso"/>
            <unzip src="${project.build.directory}/test-aars/monitor/classes.jar" dest="${project.build.testOutputDirectory}"/>
            <unzip src="${project.build.directory}/test-aars/espresso/classes.jar" dest="${project.build.testOutputDirectory}"/>
            <exec executable="${env.ANDROID_HOME}/build-tools/36.0.0/aapt2" failonerror="true">
              <arg value="link"/><arg value="-I"/><arg value="${env.ANDROID_HOME}/platforms/android-36/android.jar"/>
              <arg value="--manifest"/><arg value="${project.basedir}/android/test-manifest.xml"/>
              <arg value="-A"/><arg value="${project.basedir}/android/test-assets"/>
              <arg value="-o"/><arg value="${project.build.directory}/test-fixture.apk"/>
            </exec>
            <mkdir dir="${project.build.testOutputDirectory}/com/android/tools"/>
            <mkdir dir="${project.build.testOutputDirectory}/android"/>
            <copy file="${project.basedir}/android/test-manifest.xml" tofile="${project.build.testOutputDirectory}/android/test-manifest.xml"/>
            <echo file="${project.build.testOutputDirectory}/com/android/tools/test_config.properties">android_resource_apk=${project.build.directory}/test-fixture.apk
android_merged_manifest=${project.basedir}/android/test-manifest.xml
android_merged_assets=${project.basedir}/android/test-assets
android_custom_package=org.rerac.android.uipreview
</echo>
          </target></configuration>
        </execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration><argLine>-Xmx3g --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED</argLine>
          <systemPropertyVariables><robolectric.logging.enabled>true</robolectric.logging.enabled></systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
